# Zsh defaults managed by ubuntu-setup.
# Put machine-specific settings in ~/.zshrc outside the ubuntu-setup block.

# Keep user-installed tools ahead of system paths without accumulating entries.
typeset -U path PATH
path=("$HOME/.local/bin" "$HOME/.pixi/bin" $path)
export PATH

# Store history in the XDG state directory and share it between sessions.
_ubuntu_setup_state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/zsh"
mkdir -p -- "$_ubuntu_setup_state_dir"
HISTFILE="$_ubuntu_setup_state_dir/history"
HISTSIZE=10000
SAVEHIST=10000
setopt APPEND_HISTORY SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE
setopt AUTO_CD INTERACTIVE_COMMENTS

# Initialize Zsh's completion system once per shell.
if (( ! $+functions[compdef] )); then
  autoload -Uz compinit
  compinit
fi

# Ubuntu packages keep fzf's optional widgets in this directory.
[[ -r /usr/share/doc/fzf/examples/key-bindings.zsh ]] && source /usr/share/doc/fzf/examples/key-bindings.zsh
[[ -r /usr/share/doc/fzf/examples/completion.zsh ]] && source /usr/share/doc/fzf/examples/completion.zsh

command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"
# Cache generated scripts; binary path/metadata changes invalidate the cache
# without launching either tool merely to ask for its version.
_ubuntu_setup_completion() {
  local tool="$1" executable="${commands[$1]}" cache_dir cache key old_key tmp
  shift
  [[ -n "$executable" ]] || return 0
  cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/ubuntu-setup/zsh"
  (umask 077; mkdir -p -- "$cache_dir") || return 0
  cache="$cache_dir/$tool.zsh"
  key="$executable:$(stat -Lc '%d:%i:%s:%y:%z' -- "$executable" 2>/dev/null)"
  [[ -r "$cache.key" ]] && old_key="$(<"$cache.key")"
  if [[ ! -s "$cache" || "$key" != "$old_key" ]]; then
    tmp="$(mktemp "$cache.XXXXXXXX")" || return 0
    if "$executable" "$@" >"$tmp" && [[ -s "$tmp" ]]; then
      mv -f -- "$tmp" "$cache"
      print -r -- "$key" >"$cache.key"
    else
      rm -f -- "$tmp"
    fi
  fi
  [[ -s "$cache" ]] && source "$cache"
  return 0
}
_ubuntu_setup_completion pixi completion --shell zsh
_ubuntu_setup_completion uv generate-shell-completion zsh
unfunction _ubuntu_setup_completion

unset _ubuntu_setup_state_dir

# Ubuntu-packaged plugins; tolerate packages that have not been installed yet.
if [[ -r /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

# Keep syntax highlighting after completion, tool hooks, and other ZLE widgets.
if [[ -r /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi
