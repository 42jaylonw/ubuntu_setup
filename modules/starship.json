{
  "schema_version": 1,
  "id": "starship",
  "label": "Starship",
  "category": "shell",
  "description": "Cross-shell prompt",
  "profiles": [
    "workstation"
  ],
  "hidden": false,
  "platform": {
    "os": "ubuntu",
    "min_version": "24.04",
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "depends_on": [
    "bootstrap"
  ],
  "detect": {
    "commands": [
      "starship"
    ]
  },
  "backend": "vendor",
  "spec": {
    "installer_url": "https://starship.rs/install.sh",
    "interpreter": "sh",
    "installer_args": [
      "--yes"
    ],
    "adapter": "starship",
    "ownership_requirement": "Adapter must record installed paths and shell edits before enabling remove; do not infer ownership from PATH."
  },
  "lifecycle": {
    "install": "ensure-present",
    "update": "existing-only",
    "remove": "recorded-files",
    "preserve_user_data": true
  },
  "legacy_source": "components/10-shell.sh"
}
