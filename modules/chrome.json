{
  "schema_version": 1,
  "id": "chrome",
  "label": "Google Chrome",
  "category": "desktop",
  "description": "Web browser",
  "profiles": [
    "workstation"
  ],
  "hidden": false,
  "platform": {
    "os": "ubuntu",
    "min_version": "24.04",
    "architectures": [
      "amd64"
    ]
  },
  "depends_on": [
    "bootstrap"
  ],
  "detect": {
    "commands": [
      "google-chrome"
    ]
  },
  "backend": "deb",
  "spec": {
    "url": "https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb"
  },
  "lifecycle": {
    "install": "ensure-present",
    "update": "existing-only",
    "remove": "recorded-packages",
    "preserve_user_data": true
  },
  "legacy_source": "components/40-desktop.sh"
}
